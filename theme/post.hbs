{{!< default}}

{{#post}}

<main id="gh-main" class="gh-main">
	<article class="gh-article {{post_class}}">
		<header class="gh-article-header gh-canvas">
			{{#is "post"}}
				<span class="gh-article-meta">
					By
					{{#has author="count:>1"}}
						{{!-- Multiple authors --}}
						{{#foreach authors}}
							{{#if @first}}
								<a href="{{url}}">{{name}}</a>
							{{else if @last}}
								and <a href="{{url}}">{{name}}</a>
							{{else}}
								, <a href="{{url}}">{{name}}</a>
							{{/if}}
						{{/foreach}}
					{{else}}
						{{!-- Single author --}}
						{{#primary_author}}
							<a href="{{url}}">{{name}}</a>
						{{/primary_author}}
					{{/has}}
					{{#if primary_tag}}
						in
						<a class="gh-article-tag" href="{{primary_tag.url}}">{{primary_tag.name}}</a>
					{{/if}}
					—
					<time datetime="{{date format="YYYY-MM-DD"}}">{{date}}</time>
					{{!--
					Must stay INSIDE `.gh-article-meta`. `.gh-canvas` is a
					grid and `.gh-canvas > *` places every direct child of
					the header in its own row, so a share link that is a
					sibling of the byline gets blockified onto a row of its
					own between the byline and the title, at body type
					rather than the byline's.
					--}}
					<a class="gh-article-share" href="#/share">Share</a>
				</span>
			{{/is}}

			<h1 class="gh-article-title">{{title}}</h1>

			{{#if custom_excerpt}}
				<p class="gh-article-excerpt">{{custom_excerpt}}</p>
			{{/if}}

			{{#if feature_image}}
				<figure class="gh-article-image">
					<img
						srcset="{{img_url feature_image size="s"}} 300w,
										{{img_url feature_image size="m"}} 720w,
										{{img_url feature_image size="l"}} 960w,
										{{img_url feature_image size="xl"}} 1200w,
										{{img_url feature_image size="xxl"}} 2000w"
						sizes="(max-width: 1200px) 100vw, 1200px"
						src="{{img_url feature_image size="xl"}}"
						alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
					>
					{{#if feature_image_caption}}
						<figcaption>{{feature_image_caption}}</figcaption>
					{{/if}}
				</figure>
			{{/if}}
		</header>

		<div class="gh-content gh-canvas">
			{{content}}
		</div>

		{{!--
		Cite-this-post block (#18). BibTeX/APA only for now -- no DOI field.
		A DOI requires Rogue Scholar registration (#16) plus a GitHub Action
		to write the minted DOI back into the post via Ghost's Admin API;
		neither exists yet. Once a DOI is available, it slots in as its own
		additive `doi` field alongside `url` -- a DOI identifies the work,
		a URL locates it, and BibTeX carries both. It must never replace or
		override the post's own `{{url}}`.

		Still to decide before that lands: whether the minted DOI is stored
		in the post's `canonical_url` (what the front-matter.de workflows
		use) or in a separate custom field, since that determines whether
		the `url` line needs a conditional or can simply read
		`canonical_url` when set.

		Every literal brace below is HTML-entity-escaped (&#123;/&#125;)
		to keep it out of Handlebars' way: a literal `{` sitting directly
		next to a `{{expression}}` forms `{{{`, which Handlebars parses as
		its own (unrelated) unescaped-output syntax rather than as a
		literal brace followed by an expression.
		--}}
		{{#is "post"}}
			<section class="gh-citation gh-canvas" aria-labelledby="gh-citation-heading">
				<h2 id="gh-citation-heading" class="gh-citation-heading">Cite this post</h2>

				<div class="gh-citation-block">
					<pre class="gh-citation-text" data-citation-format="apa"><code>{{#has author="count:>1"}}{{#foreach authors}}{{#if @first}}{{name}}{{else if @last}} &amp; {{name}}{{else}}, {{name}}{{/if}}{{/foreach}}{{else}}{{#primary_author}}{{name}}{{/primary_author}}{{/has}} ({{date format="YYYY"}}). {{title}}. {{@site.title}}. {{url absolute="true"}}</code></pre>
				</div>

				<div class="gh-citation-block">
					<pre class="gh-citation-text" data-citation-format="bibtex"><code>@misc&#123;{{slug}}{{date format="YYYY"}},
  title  = &#123;&#123;{{title}}&#125;&#125;,
  author = &#123;{{#has author="count:>1"}}{{#foreach authors}}{{#if @first}}{{name}}{{else}} and {{name}}{{/if}}{{/foreach}}{{else}}{{#primary_author}}{{name}}{{/primary_author}}{{/has}}&#125;,
  year   = &#123;{{date format="YYYY"}}&#125;,
  url    = &#123;{{url absolute="true"}}&#125;
&#125;</code></pre>
				</div>
			</section>
		{{/is}}

		{{#is "post"}}
			<footer class="gh-article-footer gh-canvas">
				<div class="gh-bottom-rule" aria-hidden="true"></div>
				<nav class="gh-navigation" aria-label="pagination">
					<div class="gh-navigation-previous">
						{{#prev_post}}
							<a class="gh-navigation-link" href="{{url}}">
								<span class="gh-navigation-label">{{> icons/arrow-left}} Previous post</span>
								<h4 class="gh-navigation-title">{{title}}</h4>
							</a>
						{{/prev_post}}
					</div>

					<div class="gh-navigation-middle"></div>

					<div class="gh-navigation-next">
						{{#next_post}}
							<a class="gh-navigation-link" href="{{url}}">
								<span class="gh-navigation-label">Next post {{> icons/arrow-right}}</span>
								<h4 class="gh-navigation-title">{{title}}</h4>
							</a>
						{{/next_post}}
					</div>
				</nav>
			</footer>
		{{/is}}
	</article>
</main>

{{/post}}
